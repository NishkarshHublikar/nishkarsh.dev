{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "nishkarsh-dev",
    "main": "dist/server/server.js",
    "compatibility_date": "2025-05-01",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "assets": {
        "directory": "dist/client",
        "binding": "ASSETS"
    },
    "observability": {
        "enabled": true
    }
}